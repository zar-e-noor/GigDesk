{
  "manifest_version": 3,
  "name": "GigDesk Quick Invoice",
  "version": "1.0.0",
  "description": "Quickly generate and share invoices from your browser",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://gig-desk-seven.vercel.app/*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}


